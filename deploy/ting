#!/usr/bin/env bash
# ting: Þing's command on the server, for what the web UI can't do. The
# installer links it as /usr/local/bin/ting; it runs Docker Compose in the
# deploy folder it lives in. Run `ting help` for the commands.
set -euo pipefail

DEPLOY_DIR=${TING_DEPLOY_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)}
REPO_DIR=$(dirname "${DEPLOY_DIR}")
TING_HOME="${TING_HOME:-/opt/ting}"
# Copies of the data from before each update, to roll back to; the newest few stay.
ROLLBACK_DIR="${TING_HOME}/rollback"
KEEP_ROLLBACKS=3
# How long Þing may take to answer after starting.
START_SECONDS=${TING_START_SECONDS:-300}

log() { printf '==> %s\n' "$1"; }
warn() { printf 'WARNING: %s\n' "$1" >&2; }
die() {
	printf 'ERROR: %s\n' "$1" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage: ting <command>

  status                  what runs, and every health check
  logs [service] [-f]     the logs of app, worker and caddy (or one of them)
  start | stop | restart  start or stop Þing
  backup                  back up now, and wait for it
  restore-test            restore the newest backup into a scratch folder and check it
  restore [--snapshot ID] [--repository R]
                          restore a backup (asks for the recovery kit's backup key;
                          Þing is stopped meanwhile)
  update [--ref REF] [--no-backup]
                          update to the newest release (or REF), its files and images
                          checked against their signatures; from a checkout, to the
                          newest commit of its branch. A backup first, and a roll back
                          if the new version doesn't come up
  keys rotate             replace the master key (Þing stops for a moment)
  admin reset-allowlist   switch off both IP allowlists, when they lock everyone out
  admin reset-certificate go back to Þing's own certificate authority
  setup-token             print a new setup token, while setup is pending
  help                    this
EOF
}

compose() {
	# Built from a checkout, Þing calls itself what git calls the commit: worked
	# out each time, as an update changes the commit.
	local version=""
	if ! from_release; then version=$(git_read describe --tags --always 2>/dev/null) || true; fi
	TING_VERSION=${version} docker compose --project-directory "${DEPLOY_DIR}" \
		-f "${DEPLOY_DIR}/docker-compose.yml" "$@"
}

running() {
	[[ -n "$(compose ps -q --status running "$1" 2>/dev/null)" ]]
}

require_running() {
	running app || die "Þing isn't running: start it with ting start."
}

console() {
	compose exec -T app python -m app.console "$@"
}

# The address from .env, and the port Caddy answers on.
address() {
	local value
	value=$(sed -n 's/^TING_ADDRESS=//p' "${DEPLOY_DIR}/.env" 2>/dev/null | tail -1)
	printf '%s' "${value:-https://localhost}"
}

# Through Caddy on this server, whatever the name resolves to here.
answers() {
	local url host port
	url=$(address)
	host=$(sed -E 's|^https://([^:/]+).*|\1|' <<<"${url}")
	port=$(sed -nE 's|^https://[^:/]+:([0-9]+)$|\1|p' <<<"${url}")
	curl -fsk --max-time 5 --resolve "${host}:${port:-443}:127.0.0.1" -o /dev/null "${url}/api/health"
}

wait_until_up() {
	local waited=0
	until answers; do
		if ((waited >= START_SECONDS)); then
			warn "Þing didn't answer at $(address) within ${START_SECONDS} seconds."
			return 1
		fi
		sleep 2
		waited=$((waited + 2))
	done
	running worker || {
		warn "The worker isn't running."
		return 1
	}
}

# Git as the checkout's owner, so files keep their owner; reads work as root too.
owner() { stat -c %U "${REPO_DIR}"; }
git_read() { git -c safe.directory="${REPO_DIR}" -C "${REPO_DIR}" "$@"; }
git_owner() {
	if [[ "$(id -u)" -eq 0 && "$(owner)" != root ]]; then
		sudo -H -u "$(owner)" git -C "${REPO_DIR}" "$@"
	else
		git -C "${REPO_DIR}" "$@"
	fi
}
short() { git_read rev-parse --short "$1"; }

version() {
	if [[ -f "${DEPLOY_DIR}/VERSION" ]]; then
		printf 'Þing %s' "$(cat "${DEPLOY_DIR}/VERSION")"
		return
	fi
	printf 'Þing %s (%s)' "$(git_read describe --always --dirty --tags 2>/dev/null || echo unknown)" \
		"$(git_read log -1 --format=%cd --date=short 2>/dev/null || echo '?')"
}

cmd_status() {
	log "$(version), in ${DEPLOY_DIR}"
	compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
	echo
	require_running
	console status
}

cmd_start() {
	compose up -d
	wait_until_up && log "Þing is up at $(address)."
}

# The data, copied aside with Þing stopped, and put back.
copy_data_to() {
	# The tools image on its own first: built by compose run, its build log would
	# land in the copy, ahead of the archive.
	compose build --quiet tools >&2 || return 1
	(
		umask 077 # encrypted, but no one else's business either
		compose run --rm --no-deps -T tools tar -C /data -czf - . >"$1.part"
	) || return 1
	# A copy to roll back to that can't be read, or lacks the database, is none. The
	# listing is read whole first: grep -q stops at the database, and under pipefail
	# tar writing the names after it into a closed pipe would fail the copy.
	local listing
	gzip -t "$1.part" 2>/dev/null && listing=$(tar -tzf "$1.part") || return 1
	grep -qx './ting.db' <<<"${listing}" || return 1
	mv "$1.part" "$1"
}

put_data_back_from() {
	compose run --rm --no-deps -T tools sh -c 'find /data -mindepth 1 -delete && tar -C /data -xzf -' <"$1"
}

cmd_restore() {
	log "Stopping Þing for the restore."
	compose stop app worker
	local code=0
	compose run --rm --no-deps -e TING_COMMAND=1 worker python -m app.restore "$@" || code=$?
	log "Starting Þing again."
	compose up -d
	wait_until_up || true
	return "${code}"
}

cmd_keys() {
	[[ "${1:-}" == rotate && $# -eq 1 ]] || die "Usage: ting keys rotate"
	log "Stopping Þing to rotate the master key."
	compose stop app worker
	local code=0
	# --build: the tools image must be the code that's running, not one from before an update.
	compose run --rm --no-deps --build tools python -m app.console rotate-master-key || code=$?
	log "Starting Þing again."
	compose up -d
	wait_until_up || die "Þing doesn't answer after the rotation: see ting logs."
	if [[ ${code} -eq 0 ]]; then
		log "Backing up under the new master key."
		console backup || warn "The backup didn't work; run ting backup once it's fixed."
	fi
	return "${code}"
}

# Installed from a release (in /opt/ting, with its VERSION), or run from a checkout.
from_release() { [[ -f "${DEPLOY_DIR}/VERSION" ]]; }

# The newest full release; while there's none yet, the newest pre-release. Nothing
# when GitHub doesn't answer plainly: never a pre-release for a release unseen.
newest_release() {
	local releases="https://api.github.com/repos/${TING_REPOSITORY:-FragmentedCoder/Ting-CRM}/releases" answer status
	answer=$(mktemp)
	status=$(curl -sSL -o "${answer}" -w '%{http_code}' "${releases}/latest") || status=000
	if [[ "${status}" == 404 ]]; then
		status=$(curl -sSL -o "${answer}" -w '%{http_code}' "${releases}?per_page=1") || status=000
	fi
	if [[ "${status}" == 200 ]]; then
		sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' "${answer}" | head -1
	fi
	rm -f "${answer}"
}

RELEASE_FILES="docker-compose.yml install.sh ting .env.example VERSION"

cmd_update() {
	# Bash reads a script as it runs it, and the update changes this one: run a copy.
	if [[ -z "${TING_RUNNING_COPY:-}" ]]; then
		local running_copy
		running_copy=$(mktemp)
		cp "$(readlink -f "${BASH_SOURCE[0]}")" "${running_copy}"
		TING_RUNNING_COPY=${running_copy} TING_DEPLOY_DIR=${DEPLOY_DIR} exec bash "${running_copy}" update "$@"
	fi
	trap 'rm -f "${TING_RUNNING_COPY}"' EXIT
	local ref="" backup=true
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--ref)
			[[ $# -ge 2 ]] || die "--ref needs a release, or from a checkout a commit, tag or branch."
			ref=$2
			shift 2
			;;
		--no-backup)
			backup=false
			shift
			;;
		*) die "Unknown option $1 for update." ;;
		esac
	done
	install -d -m 0700 "${ROLLBACK_DIR}" 2>/dev/null || die "Run it with sudo: it keeps a copy of the data in ${ROLLBACK_DIR}."

	# Where it stands, and where it goes: a release, or a commit of the checkout.
	local old target staging="" branch=""
	if from_release; then
		old=$(cat "${DEPLOY_DIR}/VERSION")
		target=${ref:-$(newest_release)}
		[[ -n "${target}" ]] || die "No Þing release found to update to: GitHub didn't answer, or there's none yet."
		if [[ "${target}" == "${old}" ]]; then
			log "Already up to date: Þing ${old}."
			return 0
		fi
		log "Updating from Þing ${old} to ${target}."
		# Fetched and checked by the installed installer: a release never vouches for itself.
		staging=$(mktemp -d)
		bash "${DEPLOY_DIR}/install.sh" --fetch "${target}" "${staging}" ||
			die "Not updated: Þing ${target} couldn't be fetched and checked."
	else
		[[ -z "$(git_read status --porcelain)" ]] || die "${REPO_DIR} has changes of its own; commit or remove them first."
		old=$(git_read rev-parse HEAD)
		branch=$(git_read symbolic-ref -q --short HEAD || true)
		git_owner fetch --quiet --tags origin
		if [[ -n "${ref}" ]]; then
			target=$(git_read rev-parse --verify --quiet "${ref}^{commit}") || die "There's no commit ${ref}."
		else
			[[ -n "${branch}" ]] || die "The checkout isn't on a branch: say where to go with --ref."
			target=$(git_read rev-parse --verify --quiet '@{upstream}') || die "${branch} follows no branch: say where to go with --ref."
		fi
		if [[ "${target}" == "${old}" ]]; then
			log "Already up to date: $(version)."
			return 0
		fi
		log "Updating from $(short "${old}") to $(short "${target}")."
	fi

	if [[ "${backup}" == true ]]; then
		require_running
		console backup || die "Not updated: the backup before it didn't work. If backups are switched off, update with --no-backup (the copy to roll back to is kept either way)."
	fi
	log "Stopping Þing, and copying its data aside."
	compose stop app worker
	local copy name before=""
	if from_release; then
		copy="${ROLLBACK_DIR}/data-${old}-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
	else
		copy="${ROLLBACK_DIR}/data-$(short "${old}")-$(date -u +%Y%m%dT%H%M%SZ).tar.gz"
	fi
	if ! copy_data_to "${copy}"; then
		rm -f "${copy}.part"
		compose up -d
		die "Not updated: the data couldn't be copied aside (is there room in ${ROLLBACK_DIR}?). Þing is started again as it was."
	fi

	# The new version in place.
	if from_release; then
		before="${ROLLBACK_DIR}/release-${old}"
		rm -rf "${before}"
		install -d -m 0700 "${before}"
		for name in ${RELEASE_FILES}; do cp -p "${DEPLOY_DIR}/${name}" "${before}/${name}"; done
		for name in ${RELEASE_FILES}; do install -m 0640 "${staging}/${name}" "${DEPLOY_DIR}/${name}"; done
		chmod 0755 "${DEPLOY_DIR}/install.sh" "${DEPLOY_DIR}/ting"
		rm -rf "${staging}"
	elif [[ -n "${ref}" ]]; then
		git_owner checkout --quiet --detach "${target}"
	else
		git_owner merge --quiet --ff-only "${target}" || die "${branch} can't move to $(short "${target}") without a merge; nothing changed."
	fi
	if start_new && wait_until_up; then
		find "${ROLLBACK_DIR}" -maxdepth 1 -name 'data-*.tar.gz' -printf '%T@ %p\n' | sort -rn |
			tail -n +$((KEEP_ROLLBACKS + 1)) | cut -d' ' -f2- | xargs -r rm --
		log "Updated to $(version). The data from before is in ${copy}."
		return 0
	fi

	warn "The new version didn't come up: rolling back."
	compose logs --tail=30 app >&2 || true
	compose stop
	# The old version first: its compose file is the one that knows the old services.
	if from_release; then
		for name in ${RELEASE_FILES}; do cp -p "${before}/${name}" "${DEPLOY_DIR}/${name}"; done
	elif [[ -n "${branch}" ]]; then
		git_owner checkout --quiet "${branch}"
		git_owner reset --quiet --keep "${old}"
	else
		git_owner checkout --quiet --detach "${old}"
	fi
	put_data_back_from "${copy}"
	start_new
	wait_until_up || die "Rolled back, but Þing still doesn't answer: see ting logs."
	die "Not updated: rolled back to $(version), with the data from before the update."
}

# Start what's in place: pulled for a release, built from a checkout.
start_new() {
	if from_release; then
		compose pull --quiet && compose up -d
	else
		compose up -d --build
	fi
}

main() {
	local command=${1:-help}
	[[ $# -gt 0 ]] && shift
	case "${command}" in
	status) cmd_status ;;
	logs) compose logs --tail=200 "$@" ;;
	start) cmd_start ;;
	stop) compose stop ;;
	restart)
		compose stop
		cmd_start
		;;
	backup)
		require_running
		console backup
		;;
	restore-test)
		require_running
		console restore-test
		;;
	restore) cmd_restore "$@" ;;
	update) cmd_update "$@" ;;
	keys) cmd_keys "$@" ;;
	admin)
		case "${1:-}" in
		reset-allowlist | reset-certificate)
			require_running
			console "$1"
			;;
		*) die "Usage: ting admin reset-allowlist | reset-certificate" ;;
		esac
		;;
	setup-token)
		require_running
		compose exec -T app python -m app.setup
		;;
	help | -h | --help) usage ;;
	*)
		usage >&2
		exit 2
		;;
	esac
}

# Sourced by deploy/ting.test.sh, which tests the functions on their own.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
