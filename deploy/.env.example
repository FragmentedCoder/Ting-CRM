# Copy to .env and adjust. Never commit the real .env.
TING_ADDRESS=https://ting.example.internal
# Optional: a folder on this server for backups kept here, instead of a Docker
# volume. It must belong to UID 10001. Prefer an SMB share or S3-compatible storage
# (set in Admin -> Backups): a backup on the same disk doesn't survive losing it.
# TING_BACKUP_DIR=/var/backups/ting
# Only when the address carries a port other than 443 (the installer adds it):
# TING_HTTPS_PORT=8443
# Only for a second stack on the same server, such as a test copy: where its master
# key lives, instead of /etc/ting (owned by UID 10001, mode 0700).
# TING_ETC=/srv/ting-test/etc
